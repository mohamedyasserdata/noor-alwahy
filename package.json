{
  "name": "noor-alwahy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "dev": "node scripts/run-local-dev.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "pnpm check:logical-css && pnpm check:no-messaging && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:logical-css": "node scripts/check-logical-css.mjs",
    "check:no-messaging": "node scripts/check-no-messaging-routes.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types": "node scripts/generate-database-types.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "pdf:spike:fixture": "node scripts/pdf-spike/fetch-quran-fixture.mjs",
    "pdf:spike:generate": "node scripts/pdf-spike/generate.mjs",
    "pdf:spike:verify": "node scripts/pdf-spike/verify.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@sparticuz/chromium-min": "153.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3",
    "lucide-react": "1.59.0",
    "luxon": "3.7.2",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "puppeteer-core": "25.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsqr": "1.4.0",
    "lint-staged": "17.6.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "qrcode": "1.5.4",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
